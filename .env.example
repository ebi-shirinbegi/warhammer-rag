# Copy to .env at the repository root and fill in locally. Never commit .env.
GOOGLE_API_KEY=
# Choose an available model in Google AI Studio before implementing LLM calls.
GOOGLE_MODEL=

# Optional overrides. Relative directory paths resolve against RAG_PROJECT_ROOT.
# RAG_PROJECT_ROOT=/absolute/path/to/rag-class-project
# RAG_RAW_DIR=data/raw
# RAG_PROCESSED_DIR=data/processed
# RAG_INDEX_DIR=data/indexes
# RAG_EVAL_DIR=evaluation/datasets
# RAG_REPORT_DIR=evaluation/reports
