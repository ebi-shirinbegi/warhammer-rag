  "query_abilities_corrected": [
    {
      "line": "1",
      "type": "Core",
      "ability_id": "000008339",
      "ability_name": "Deadly Demise",
      "ability_text": "DEADLY DEMISE24.08From detonating ammo stores to corrosive innards or frenzied death throes, some targets are deadly even in defeat.This ability always takes the form Deadly Demise X. Each time a model with this ability is destroyed, after the units embarked within it (if any) have made their emergency disembark moves, roll one D6. On a 6, that model suffers a deadly demise; each unit within 6\" of that model suffers a number of mortal wounds denoted by X (if this is a random number, roll separately for each unit within 6\").",
      "parameter": "D3"
    },
    {
      "line": "2",
      "type": "Core",
      "ability_id": "000008346",
      "ability_name": "Leader",
      "ability_text": "LEADER24.22Mighty heroes fight at the forefront of battle.Before the battle, in the Muster Armies step, for each leader and support unit in your army, you can select one friendly bodyguard unit that unit can lead. That unit will then lead that bodyguard unit for the battle and form an attached unit with it.Unless otherwise stated, each bodyguard unit can only have one leader unit and one support unit attached to it.",
      "parameter": ""
    },
    {
      "line": "3",
      "type": "Faction",
      "ability_id": "000000707",
      "ability_name": "Shadow in the Warp",
      "ability_text": "If your Army Faction is TYRANIDS, once per battle, in either player\u00e2\u0080\u0099s Command phase, if one or more units from your army with this ability are on the battlefield, you can unleash the Shadow in the Warp. When you do, each enemy unit on the battlefield must take a Battle-shock test. Each time an enemy unit takes such a Battle-shock test, if it is within 6\" of one or more Synapse units from your army, subtract 1 from that test.",
      "parameter": ""
    },
    {
      "line": "4",
      "type": "Faction",
      "ability_id": "000000705",
      "ability_name": "Synapse",
      "ability_text": "If your Army Faction is TYRANIDS, while a TYRANIDS unit from your army is within 6\" of one or more friendly Synapse models, that TYRANIDS unit is said to be within Synapse Range of that model and of your army. While a TYRANIDS unit from your army is within Synapse Range of your army: Each time that unit takes a Battle-shock test, take that test on 3D6 instead of 2D6. Each time a model in that unit makes a melee attack, add 1 to the Strength characteristic of that attack.",
      "parameter": ""
    },
    {
      "line": "5",
      "type": "Datasheet",
      "ability_id": null,
      "ability_name": "Will of the Hive Mind",
      "ability_text": "Once per battle round, one model from your army with this ability can use it when a friendly TYRANIDS unit within 12\" of that model is targeted with a Stratagem. If it does, reduce the CP cost of that usage of that Stratagem by 1CP.",
      "parameter": ""
    },
    {
      "line": "6",
      "type": "Datasheet",
      "ability_id": null,
      "ability_name": "Onslaught (Aura, Psychic)",
      "ability_text": "While a friendly TYRANIDS unit is within 6\" of this model, ranged weapons equipped by models in that unit have the [ASSAULT] and [LETHAL HITS] abilities.",
      "parameter": ""
    }
  ],
