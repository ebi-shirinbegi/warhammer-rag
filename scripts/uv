#!/bin/sh
# Keep all downloaded interpreters and caches inside this checkout.
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export UV_CACHE_DIR="${UV_CACHE_DIR:-$project_dir/.cache/uv}"
export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-$project_dir/.tools/python}"
export PRE_COMMIT_HOME="${PRE_COMMIT_HOME:-$project_dir/.cache/pre-commit}"
if [ -x "$project_dir/.tools/uv/bin/uv" ]; then
    exec "$project_dir/.tools/uv/bin/uv" "$@"
fi
if command -v uv >/dev/null 2>&1; then
    exec uv "$@"
fi
echo 'uv is missing. Run ./scripts/setup.sh from the repository root.' >&2
exit 1
